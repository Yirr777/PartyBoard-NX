   assert(result == mem1Address);
   return result;
 }
+#elif defined(__SWITCH__)
+#include <switch.h>
+#include <cstring>
+#include <malloc.h>
+// mp4-switch: MEM1 between two no-access guard regions, so a game write past either end faults
+// where it happens instead of corrupting the C heap.
+static void* AllocMEM1(u32 size) {
+  constexpr size_t Guard = 0x100000;
+  const size_t body = (static_cast<size_t>(size) + 0xFFF) & ~static_cast<size_t>(0xFFF);
+  auto* block = static_cast<u8*>(memalign(0x1000, Guard + body + Guard));
+  if (block == nullptr) {
+    return calloc(1, size);
+  }
+  std::memset(block + Guard, 0, body);
+  if (R_FAILED(svcSetMemoryPermission(block, Guard, Perm_None)) ||
+      R_FAILED(svcSetMemoryPermission(block + Guard + body, Guard, Perm_None))) {
+    Log.warn("MEM1 guard pages unavailable");
+  }
+  return block + Guard;
+}
 #else
 static void* AllocMEM1(u32 size) {
   return calloc(1, size);
