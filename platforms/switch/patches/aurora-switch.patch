+#ifdef __SWITCH__
+// mp4-switch: every card write copies the whole image to a temporary file (see open_atomic_file),
+// which takes seconds for a 16 MiB image on an SD card. Move an oversized image's saves to a
+// 59-block one (512 KiB), keeping the original as <name>.bak. On any doubt the card stays as it was.
+static void shrink_raw_card(const std::filesystem::path& path, const char* game, const char* maker) {
+  constexpr size_t BlockSize = 0x2000;
+  constexpr size_t EntrySize = 0x40;
+  constexpr size_t EntryCount = 127;
+  constexpr uint32_t SmallBlocks = 59;
+  constexpr uint16_t SmallMbit = 4;
+
+  std::error_code ec;
+  if (SelectedFileType != CARD_RAWIMAGE || game == nullptr || maker == nullptr ||
+      !std::filesystem::exists(path, ec)) {
+    return;
+  }
+  const std::string pathString = aurora::io::fs_path_to_string(path);
+
+  std::vector<uint8_t> head(BlockSize * 3);
+  FILE* file = std::fopen(pathString.c_str(), "rb");
+  if (file == nullptr) {
+    return;
+  }
+  const size_t headRead = std::fread(head.data(), 1, head.size(), file);
+  std::fclose(file);
+  const auto be16 = [](const uint8_t* p) { return static_cast<uint16_t>((p[0] << 8) | p[1]); };
+  if (headRead != head.size() || be16(&head[0x22]) <= SmallMbit) {
+    return;
+  }
+
+  // The directory with the higher update counter is the live one.
+  const uint8_t* dir0 = &head[BlockSize];
+  const uint8_t* dir1 = &head[BlockSize * 2];
+  const uint8_t* dir = be16(dir0 + 0x1FFA) >= be16(dir1 + 0x1FFA) ? dir0 : dir1;
+  std::vector<std::string> names;
+  uint32_t usedBlocks = 0;
+  for (size_t i = 0; i < EntryCount; ++i) {
+    const uint8_t* entry = dir + i * EntrySize;
+    if (entry[0] == 0xFF) {
+      continue;
+    }
+    if (std::strncmp(reinterpret_cast<const char*>(entry), game, 4) != 0 ||
+        std::strncmp(reinterpret_cast<const char*>(entry + 4), maker, 2) != 0) {
+      Log.warn("Keeping large card {}: it holds another game's save", pathString);
+      return;
+    }
+    names.emplace_back(reinterpret_cast<const char*>(entry + 8), strnlen(reinterpret_cast<const char*>(entry + 8), 32));
+    usedBlocks += be16(entry + 0x38);
+  }
+  if (usedBlocks > SmallBlocks) {
+    Log.warn("Keeping large card {}: {} blocks in use", pathString, usedBlocks);
+    return;
+  }
+
+  auto smallPath = path;
+  smallPath += ".small";
+  auto backupPath = path;
+  backupPath += ".bak";
+  if (std::filesystem::exists(backupPath, ec)) {
+    Log.warn("Keeping large card {}: {} already exists", pathString, aurora::io::fs_path_to_string(backupPath));
+    return;
+  }
+  std::filesystem::remove(smallPath, ec);
+
+  bool ok = false;
+  {
+    aurora::card::CardRawFile large;
+    aurora::card::CardRawFile small;
+    large.InitCard(game, maker);
+    small.InitCard(game, maker);
+    ok = large.open(path);
+    if (ok) {
+      small.open(smallPath);
+      ok = small.format(aurora::card::ECardSlot::SlotA, aurora::card::ECardSize::Card59Mb) ==
+           aurora::card::ECardResult::READY;
+      small.close();
+      ok = ok && small.open(smallPath);
+    }
+    std::vector<std::vector<uint8_t>> saves;
+    for (const auto& name : names) {
+      if (!ok) {
+        break;
+      }
+      std::vector<uint8_t> gci(large.extractGci(name.c_str(), nullptr, 0));
+      ok = !gci.empty() && large.extractGci(name.c_str(), gci.data(), gci.size()) == gci.size() &&
+           small.insertGci(gci.data(), gci.size(), false);
+      saves.push_back(std::move(gci));
+    }
+    ok = ok && small.commit() == aurora::card::ECardResult::READY;
+    small.close();
+
+    // Read the new image back; the first 64 bytes are the directory entry, which may differ.
+    ok = ok && small.open(smallPath);
+    for (size_t i = 0; ok && i < names.size(); ++i) {
+      std::vector<uint8_t> copy(saves[i].size());
+      ok = small.extractGci(names[i].c_str(), copy.data(), copy.size()) == copy.size() &&
+           std::memcmp(copy.data() + 64, saves[i].data() + 64, copy.size() - 64) == 0;
+    }
+    small.close();
+    large.close();
+  }
+
+  if (ok) {
+    std::filesystem::rename(path, backupPath, ec);
+    ok = !ec;
+  }
+  if (ok) {
+    std::filesystem::rename(smallPath, path, ec);
+    if (ec) {
+      std::error_code restoreError;
+      std::filesystem::rename(backupPath, path, restoreError);
+      ok = false;
+    }
+  }
+  if (!ok) {
+    std::filesystem::remove(smallPath, ec);
+    Log.warn("Could not shrink card {}; keeping it as it was", pathString);
+    return;
+  }
+  Log.info("Moved {} save(s) to a 59-block card; the original is {}", names.size(),
+           aurora::io::fs_path_to_string(backupPath));
+}
+#endif
