diff --git a/absl/container/internal/hash_policy_traits.h b/absl/container/internal/hash_policy_traits.h
index e469d71..893ac98 100644
--- a/absl/container/internal/hash_policy_traits.h
+++ b/absl/container/internal/hash_policy_traits.h
@@ -155,9 +155,15 @@ template <class Policy, class = void>
 // silent error: the address of * will never be NULL [-Werror=address]
 #pragma GCC diagnostic ignored "-Waddress"
 #endif
+#if defined(__SWITCH__)
+    // mp4-switch: devkitA64's GCC 16 rejects comparing a function template's address with
+    // nullptr in a constant expression; the non-type-erased hasher is equivalent.
+    return &hash_slot_fn_non_type_erased<Hash, kIsDefault>;
+#else
     return Policy::template get_hash_slot_fn<Hash, kIsDefault>() == nullptr
                ? &hash_slot_fn_non_type_erased<Hash, kIsDefault>
                : Policy::template get_hash_slot_fn<Hash, kIsDefault>();
+#endif
 #if defined(__GNUC__) && !defined(__clang__)
 #pragma GCC diagnostic pop
 #endif
diff --git a/absl/container/internal/raw_hash_set.cc b/absl/container/internal/raw_hash_set.cc
index d37c781..35647bc 100644
--- a/absl/container/internal/raw_hash_set.cc
+++ b/absl/container/internal/raw_hash_set.cc
@@ -80,14 +80,14 @@ void ValidateMaxCapacity(size_t capacity, size_t key_size, size_t slot_size) {
 // Returns "random" seed.
 inline size_t RandomSeed() {
   constexpr size_t kIncrement = 0xad53;
-#ifdef ABSL_HAVE_THREAD_LOCAL
+#if defined(ABSL_HAVE_THREAD_LOCAL) && !defined(__SWITCH__)
   static thread_local size_t counter = 0;
   counter += kIncrement;
   size_t value = counter;
-#else   // ABSL_HAVE_THREAD_LOCAL
+#else   // ABSL_HAVE_THREAD_LOCAL && !__SWITCH__
   static std::atomic<size_t> counter(0);
-  size_t value = counter.fetch_add(kIncrement, std::memory_order_relaxed);
-#endif  // ABSL_HAVE_THREAD_LOCAL
+  size_t value = counter.fetch_add(kIncrement, std::memory_order_relaxed) + kIncrement;
+#endif  // ABSL_HAVE_THREAD_LOCAL && !__SWITCH__
   return value ^ static_cast<size_t>(reinterpret_cast<uintptr_t>(&counter));
 }
 
