# The Switch executable: the DOL, every isolated REL, the platform glue, NVK, and the .nro.

# rel_registry.c: name, ObjectSetup and data bounds of each REL.
set(_reg "${CMAKE_BINARY_DIR}/rel/rel_registry.c")
set(_decls "")
set(_rows "")
set(_rel_objs "")
foreach(_rel IN LISTS MP4_SWITCH_RELS)
    string(APPEND _decls
        "extern void mp4rel_${_rel}_ObjectSetup(void);\n"
        "extern unsigned char __start_mp4ovl_${_rel}[] __attribute__((weak));\n"
        "extern unsigned char __stop_mp4ovl_${_rel}[] __attribute__((weak));\n"
        "extern unsigned char __start_mp4bss_${_rel}[] __attribute__((weak));\n"
        "extern unsigned char __stop_mp4bss_${_rel}[] __attribute__((weak));\n")
    string(APPEND _rows
        "    {\"${_rel}\", mp4rel_${_rel}_ObjectSetup, __start_mp4ovl_${_rel}, __stop_mp4ovl_${_rel},\n"
        "        __start_mp4bss_${_rel}, __stop_mp4bss_${_rel}},\n")
    list(APPEND _rel_objs "${CMAKE_BINARY_DIR}/rel/${_rel}.o")
endforeach()
list(LENGTH MP4_SWITCH_RELS _rel_count)
file(GENERATE OUTPUT "${_reg}" CONTENT
"// Generated by platforms/switch/switch_targets.cmake.
#include \"rel_registry.h\"
${_decls}
const Mp4Rel mp4RelTable[] = {
${_rows}};
const unsigned mp4RelCount = ${_rel_count};
")

target_sources(partyboard PRIVATE
    "${_reg}"
    ${_rel_objs}
    platforms/switch/nx_init.c
    platforms/switch/bo_pool.c
    platforms/switch/sqlite_vfs.c
    platforms/switch/posix_gaps.c)
set_source_files_properties(${_rel_objs} PROPERTIES EXTERNAL_OBJECT TRUE GENERATED TRUE)
target_include_directories(partyboard PRIVATE platforms/switch)
target_link_libraries(partyboard PRIVATE sqlite3)

# Horizon has no dynamic loader, so the Vulkan driver is linked statically.
target_link_libraries(partyboard PRIVATE
    "${MP4_SWITCH_NVK_DIR}/lib/libvulkan.a"
    "${DEVKITPRO}/portlibs/switch/lib/libdrm_nouveau.a"
    nx m)
# Dawn references the entry point but links after the driver, so force it in.
target_link_options(partyboard PRIVATE
    "-Wl,--undefined=vk_icdGetInstanceProcAddr"
    -Wl,--wrap=pthread_create
    -Wl,--wrap=memalign
    -Wl,--wrap=free)

set(PARTY_BOARD_NX_VERSION "${PARTY_BOARD_SHORT_VERSION_STRING}")
nx_generate_nacp(partyboard.nacp
    NAME "Party Board"
    AUTHOR "Mario Party R&D (Switch port: mp4-switch)"
    VERSION "${PARTY_BOARD_NX_VERSION}")

# res/ is read through the working directory (the .nro's folder), so it ships beside the .nro
# rather than in romfs; the romfs only carries a marker.
set(_romfs "${CMAKE_BINARY_DIR}/romfs")
file(MAKE_DIRECTORY "${_romfs}")
file(WRITE "${_romfs}/partyboard.txt" "Party Board for Nintendo Switch\n")
include(dkp-asset-folder)
dkp_add_asset_target(partyboard_romfs "${_romfs}")
set_target_properties(partyboard_romfs PROPERTIES DKP_ASSET_FILES "${_romfs}/partyboard.txt")

find_program(MP4_SWITCH_PYTHON NAMES python3 python REQUIRED)
add_custom_command(TARGET partyboard POST_BUILD
    COMMAND "${MP4_SWITCH_PYTHON}" "${MP4_SWITCH_DIR}/patch_chkfeat.py" "$<TARGET_FILE:partyboard>"
    VERBATIM)

nx_create_nro(partyboard
    ICON "${MP4_SWITCH_DIR}/icon.jpg"
    NACP partyboard.nacp
    ROMFS partyboard_romfs)
